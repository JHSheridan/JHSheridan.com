body {
  width: 100%;
  margin: 0;
  padding: 0;
  border-top: 6px solid #8D0001;
  color: #EFEDEA;
  background-color: #202B33;
  font-family: Magdelin;
  font-size: 19px;
  line-height: 1.35;
}

h2 {
  font-size: 36px;
  font-weight: 600;
}
h2:first-of-type {
  margin-top: 0;
  margin-bottom: 19px;
}

h3 {
  font-size: 26px;
  font-weight: 600;
  margin-bottom: 4px;
  margin-top: 15px;
}

h4 {
  font-size: 23px;
  font-weight: 600;
  margin-bottom: 4px;
  margin-top: 15px;
}

p {
  margin: 0 0 12px 0;
  max-width: 600px;
}

em {
  font-style: italic;
}

blockquote {
  max-width: 600px;
}

a {
  color: #EFEDEA;
  text-decoration: underline;
}

ul {
  padding-left: 20px;
  list-style-type: square;
}
ul li {
  padding-bottom: 4px;
}

strong {
  font-weight: 600;
}

#site-header {
  grid-area: header;
}

#site-main {
  grid-area: main;
}

#site-footer {
  grid-area: footer;
}

#site-container {
  max-width: 100%;
  padding: 0 20px;
  margin-bottom: 90px;
  display: grid;
  grid: "header" auto "main" 1fr "footer" auto/1fr;
}
@media only screen and (min-width: 1100px) {
  #site-container {
    grid: "header main" auto "footer footer" auto/30% 70%;
  }
}

#site-main {
  max-width: 800px;
}
@media only screen and (min-width: 700px) and (max-width: 1100px) {
  #site-main {
    margin: 0 0 0 56px;
  }
}
@media only screen and (min-width: 1100px) {
  #site-main {
    padding: 142px 0 0 50px;
  }
}

@media only screen and (min-width: 1100px) {
  body.home #site-main {
    padding: 155px 0 0 50px;
  }
}

#site-header {
  display: flex;
  gap: 20px;
  width: 100%;
  padding: 25px 0 35px 0;
}
@media only screen and (min-width: 1100px) {
  #site-header {
    display: block;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: none;
    padding: 65px 0 0 0;
    margin-top: 68px;
  }
}
#site-header #banner::after {
  content: "";
  display: table;
  clear: both;
}
@media only screen and (min-width: 1100px) {
  #site-header #banner {
    float: right;
    padding-right: 50px;
  }
}
#site-header img {
  display: none;
}
@media only screen and (min-width: 350px) {
  #site-header img {
    display: block;
    float: left;
    max-width: 45px;
  }
}
@media only screen and (min-width: 1100px) {
  #site-header img {
    float: right;
    max-width: 60px;
  }
}
#site-header .name-description {
  float: left;
}
@media only screen and (min-width: 350px) {
  #site-header .name-description {
    padding: 0 0 0 10px;
  }
}
@media only screen and (min-width: 1100px) {
  #site-header .name-description {
    float: right;
    clear: both;
    margin-top: 7px;
  }
}
#site-header .name-description .site-name {
  font-weight: 600;
  font-size: 24px;
  margin: 0;
}
@media only screen and (min-width: 1100px) {
  #site-header .name-description .site-name {
    font-size: 30px;
  }
}
#site-header .name-description .site-name a {
  text-decoration: none;
  color: #EFEDEA;
}
#site-header .name-description .site-description {
  font-weight: 400;
  font-size: 13px;
  margin: 0;
}
@media only screen and (min-width: 1100px) {
  #site-header .name-description .site-description {
    font-size: 18px;
    text-align: right;
  }
}
#site-header .name-description .site-description br {
  display: none;
}
@media only screen and (min-width: 1100px) {
  #site-header .name-description .site-description br {
    display: block;
  }
}

#full-menu {
  display: none;
  flex-grow: 1;
}
@media only screen and (min-width: 700px) {
  #full-menu {
    display: block;
  }
}
@media only screen and (min-width: 1100px) {
  #full-menu {
    float: right;
    clear: both;
    padding-right: 50px;
    margin-top: 20px;
  }
}
#full-menu nav {
  float: right;
}
@media only screen and (min-width: 1100px) {
  #full-menu nav {
    float: none;
  }
}
#full-menu nav ul {
  list-style-type: none;
  padding: 0;
  margin: 13px 0 0 0;
}
#full-menu nav ul li {
  float: left;
  margin-left: 20px;
}
@media only screen and (min-width: 1100px) {
  #full-menu nav ul li {
    float: none;
    text-align: right;
    margin-bottom: 10px;
  }
}
#full-menu nav ul li a {
  color: #EFEDEA;
  text-decoration: none;
}
@media only screen and (min-width: 1100px) {
  #full-menu nav ul li a {
    font-size: 21px;
    opacity: 0.8;
  }
  #full-menu nav ul li a:hover {
    opacity: 1;
  }
}
#full-menu nav ul li .active {
  font-weight: 500;
  text-decoration: underline;
  opacity: 1;
}

#mobile-menu {
  flex-grow: 1;
}
@media only screen and (min-width: 700px) {
  #mobile-menu {
    display: none;
  }
}
#mobile-menu input {
  display: none;
}

.open {
  background-color: #EFEDEA;
  width: 24px;
  height: 4px;
  display: block;
  border-radius: 2px;
  cursor: pointer;
  position: relative;
  top: 8px;
}

.open:before {
  content: "";
  background-color: #EFEDEA;
  width: 24px;
  height: 4px;
  display: block;
  border-radius: 2px;
  position: relative;
  top: -8px;
  transform: rotate(0deg);
  transition: all 0.3s ease;
}

.open:after {
  content: "";
  background-color: #EFEDEA;
  width: 24px;
  height: 4px;
  display: block;
  border-radius: 2px;
  position: relative;
  top: 4px;
  transform: rotate(0deg);
  transition: all 0.3s ease;
}

.menuOpen {
  width: 24px;
  height: 20px;
  display: block;
  padding: 13px 0 0 0;
  cursor: pointer;
  float: right;
}

.menuOpen:hover .open:before {
  top: -9px;
}

.menuOpen:hover .open:after {
  top: 5px;
}

.menu {
  position: fixed;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  background: rgba(141, 0, 1, 0.85);
}

.menu label {
  width: 30px;
  height: 30px;
  position: absolute;
  right: 20px;
  top: 20px;
  background-size: 100%;
  cursor: pointer;
}

.menu .menuContent {
  position: relative;
  top: 30%;
  font-size: 40px;
  text-align: center;
  padding-bottom: 20px;
  margin-top: -170px;
}

.menu ul {
  list-style: none;
  padding: 0;
  margin: 0 auto;
  max-width: 75%;
}

.menu ul li a {
  display: block;
  color: white;
  text-decoration: none;
  transition: color 0.2s;
  padding: 10px 0;
}

.menu ul li a:hover {
  color: #8D0001;
}

.menu ul li:hover {
  background: rgba(255, 255, 255, 0.9);
}

.menuEffects {
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.5s, visibility 0.5s;
}

.menuEffects ul {
  transform: translateY(0%);
  transition: all 0.5s;
}

#menuToggle:checked ~ .menuEffects {
  opacity: 1;
  visibility: visible;
  transition: opacity 0.5s;
}

#menuToggle:checked ~ .menuEffects ul {
  opacity: 1;
}

#menuToggle:checked ~ .menuOpen .open {
  background-color: transparent;
}

#menuToggle:checked ~ .menuOpen .open:before {
  content: "";
  background-color: white;
  transform: rotate(45deg);
  position: absolute;
  top: 0;
  right: 0;
  z-index: 1;
}

#menuToggle:checked ~ .menuOpen .open:after {
  content: "";
  background-color: white;
  transform: rotate(-45deg);
  position: relative;
  top: 0;
  right: 0;
  z-index: 1;
}

#menuToggle:not(:checked) ~ .menuEffects ul {
  transform: translateY(-30%);
}

.nav-blink {
  color: #ffffff !important;
  opacity: 1 !important;
  transform: scale(1.05) !important;
  transition: all 0.1s ease !important;
  font-weight: 500 !important;
}

footer {
  display: none;
  position: absolute;
  bottom: 3px;
  left: 3px;
  font-size: 12px;
}
footer p {
  padding: 0;
  margin: 0;
}
footer a {
  text-decoration: none;
}

.teaser {
  margin: 0 0 0px -20px;
  padding: 2px 0 8px 20px;
  border-radius: 8px;
  transition: background-color 0.3s ease;
  max-width: 560px;
  display: block;
  cursor: pointer;
  text-decoration: none;
}
.teaser:hover {
  background-color: rgba(255, 255, 255, 0.05);
  border: solid 1px rgba(255, 255, 255, 0.07);
}
.teaser span.emoji {
  font-size: 20px;
  vertical-align: 0.15em;
}
.teaser .cta {
  font-size: 18px;
  text-decoration: underline;
}
.teaser .arrow {
  display: inline-block;
}
.teaser:hover .arrow {
  transform: translateX(4px);
  transition: transform 0.3s ease-out;
}

@keyframes slide {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(6px);
  }
}
.home-page-meta {
  display: flex;
  column-gap: 50px;
  margin: -89px 0 -80px 0;
  justify-content: space-between;
  max-width: 720px;
}
.home-page-meta .meta-item {
  align-content: center;
  padding-top: 13px;
}
.home-page-meta .meta-item .label {
  text-transform: uppercase;
  font-size: 13px;
  letter-spacing: 0.3px;
  margin-bottom: 0 !important;
  color: #989B9D;
}
.home-page-meta .meta-item .label .emoji {
  font-size: 13px;
}
.home-page-meta .meta-item .property {
  font-size: 17px;
}
.home-page-meta .meta-item-button {
  padding-top: 0;
}

h4 .emoji {
  font-size: 19px;
}

.meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: -70px 0 -65px 0;
}
.meta .item {
  margin: -28px 0 0 0;
}
.meta .item p {
  margin: 0 !important;
}
.meta .item .title {
  text-transform: uppercase;
  font-size: 13px;
  font-weight: 600;
  padding: 0 0 3px 0;
  letter-spacing: 0.3px;
}
.meta .item .info {
  font-size: 18px;
  font-weight: 500;
}
.meta .item .info .emoji {
  padding-right: 6px;
  font-size: 16px;
}

.title-em {
  font-style: italic;
  text-decoration: underline;
}

.cap {
  margin: 0;
  padding: 0;
  font-style: italic;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  font-size: 15px;
  margin-top: -5px;
}

.now-nav {
  display: flex;
  justify-content: space-between;
  max-width: 600px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding-top: 25px;
  margin: 25px 0 14px 0;
}
.now-nav .item .title {
  text-transform: uppercase;
  font-size: 14px;
  margin-bottom: 0 !important;
  color: #989B9D;
}

/*
.goals {
  display: flex;
  flex-wrap: wrap;

  .goal {
   width: 50%; 
    &:nth-child(odd) {
      padding-right: 10px;
    }
    &:nth-child(even) {
      padding-left: 10px;
    }
  }
}
*/
.page-meta {
  display: flex;
  column-gap: 50px;
  margin: 10px 0 8px 0;
}
.page-meta .meta-item {
  align-content: center;
  padding-top: 13px;
}
.page-meta .meta-item .label {
  text-transform: uppercase;
  font-size: 14px;
  margin-bottom: 0 !important;
  color: rgba(232, 230, 228, 0.6);
}
.page-meta .meta-item .meta-button {
  background-color: #8D0001;
  padding: 9px 12px;
  font-weight: 600;
  font-size: 19px;
  border: #EFEDEA solid 3px;
  text-decoration: none !important;
}
.page-meta .meta-item-button {
  padding-top: 0;
}

blockquote {
  margin: 25px 0;
  font-size: 19px;
  background-color: rgba(255, 255, 255, 0.08);
  padding: 18px 18px;
  border-radius: 4px;
  border: rgba(255, 255, 255, 0.3) solid 1px;
  border-left: #8D0001 solid 5px;
}
blockquote footer {
  display: block;
  border: none;
  text-align: right;
  font-size: 17px;
}

.services-container {
  margin: 25px 0;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  padding: 15px 0;
}

.services {
  display: flex;
  flex-wrap: wrap;
}
.services .service {
  flex: 50%;
  padding: 0 30px 10px 0;
}
.services .service h1 {
  font-size: 25px !important;
  margin-bottom: 0 !important;
  font-weight: 600;
}
.services .service p {
  font-size: 18px;
}

.work-gallery {
  list-style-type: none !important;
  padding: 0 !important;
  margin: 30px 0;
  display: flex;
  flex-wrap: wrap;
  width: 100%;
}
.work-gallery li {
  max-width: 160px;
  margin: 0 20px 20px 0;
  padding: 0 !important;
  border: 8px solid #FFF;
}
.work-gallery li a img {
  width: 100%;
  display: block;
}

.contact-info {
  margin-top: 20px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  padding: 14px 12px 4px 12px;
  max-width: 380px;
  background-color: rgba(255, 255, 255, 0.05);
  font-size: 19px;
}

.contact-form {
  margin-top: 22px;
}

form.contact-page {
  width: 100%;
  max-width: 625px;
  margin-top: 10px;
  margin-bottom: 40px;
}
form.contact-page input, form.contact-page textarea {
  font-family: magdelin;
  font-size: 18px;
  color: #FFF;
  background-color: rgba(255, 255, 255, 0.12);
  border: none;
  border-bottom: #8D0001 3px solid;
  padding: 12px 8px;
  margin: 0 0 10px 0;
}
form.contact-page input::placeholder, form.contact-page textarea::placeholder {
  color: rgba(255, 255, 255, 0.65);
}
form.contact-page .form-fields .name-field, form.contact-page .form-fields .email-field {
  width: 48.5%;
  display: inline-block;
}
form.contact-page .form-fields .name-field input, form.contact-page .form-fields .email-field input {
  height: 50px;
  width: 100%;
  display: block;
}
form.contact-page .form-fields .name-field {
  margin-right: 2%;
}
form.contact-page .form-fields label {
  font-size: 18px;
  font-weight: 500;
  padding-bottom: 3px;
  display: block;
}
form.contact-page .form-fields textarea {
  width: 100%;
  height: 200px;
}
form.contact-page .button-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
form.contact-page .button-field p {
  font-size: 18px;
  margin-bottom: 0 !important;
}
form.contact-page .button-field button {
  font-family: magdelin;
  font-size: 23px;
  font-weight: 600;
  background-color: #8D0001;
  border: 3px solid #FFF;
  color: #FFF;
  padding: 5px 14px;
}
form.contact-page .button-field button:hover {
  background-color: #ab1b1c;
}
form.contact-page .button-field button:active {
  transform: translateY(2px);
}

@property --progress-value {
  syntax: "<integer>";
  inherits: true;
  initial-value: 0;
}
:root {
  --progress-bar-color: #cfd8dc;
  --progress-value-color: #2196f3;
  --progress-filled-color-h: 4.1;
  --progress-filled-color-s: 89.6;
  --progress-filled-color-l: 58.4;
  --progress-empty-color-h: 122.4;
  --progress-empty-color-s: 39.4;
  --progress-empty-color-l: 49.2;
}

progress[value] {
  display: inline-block;
  position: relative;
  appearance: none;
  width: 80%;
  height: 6px;
  border: 0;
  margin: 0 0 12px 0;
  --border-radius: 10px;
  border-radius: var(--border-radius);
  counter-reset: progress var(--progress-value);
  --progress-value-string: counter(progress) "%";
  --progress-max-decimal: calc(var(--value, 0) / var(--max, 0));
  --progress-value-decimal: calc(var(--progress-value, 0) / var(--max, 0));
  --progress-value-percent: calc(var(--progress-value-decimal) * 100%);
  --progress-value-color: hsl(
    calc((var(--progress-empty-color-h) + (var(--progress-filled-color-h) - var(--progress-empty-color-h)) * var(--progress-value-decimal)) * 1deg)
    calc((var(--progress-empty-color-s) + (var(--progress-filled-color-s) - var(--progress-empty-color-s)) * var(--progress-value-decimal)) * 1%)
    calc((var(--progress-empty-color-l) + (var(--progress-filled-color-l) - var(--progress-empty-color-l)) * var(--progress-value-decimal)) * 1%)
  );
  animation: calc(3s * var(--progress-max-decimal)) linear 0.5s 1 normal both progress;
}
@supports selector(::-moz-progress-bar) {
  progress[value] {
    --progress-value-decimal: calc(var(--value, 0) / var(--max, 0));
  }
}

progress[value]::-webkit-progress-bar {
  background-color: var(--progress-bar-color);
  border-radius: var(--border-radius);
  overflow: hidden;
}

progress[value]::-webkit-progress-value {
  width: var(--progress-value-percent) !important;
  background-color: var(--progress-value-color);
  border-radius: var(--border-radius);
}

progress[value]::-moz-progress-bar {
  width: var(--progress-value-percent) !important;
  background-color: var(--progress-value-color);
  border-radius: var(--border-radius);
}

progress[value]::after {
  display: flex;
  align-items: center;
  justify-content: center;
  --size: 32px;
  width: var(--size);
  height: var(--size);
  position: absolute;
  left: var(--progress-value-percent);
  top: 50%;
  transform: translate(-50%, -50%);
  background-color: var(--progress-value-color);
  border-radius: 50%;
  content: attr(value);
  content: var(--progress-value-string, var(--value));
  font-size: 12px;
  font-weight: 700;
  color: #fff;
}

@keyframes progress {
  from {
    --progress-value: 0;
  }
  to {
    --progress-value: var(--value);
  }
}