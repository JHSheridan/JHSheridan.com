*, *::before, *::after {
  box-sizing: border-box;
}

html, body, div, span, object, iframe, figure, h1, h2, h3, h4, h5, h6, p, blockquote, pre, a, code, em, img, small, strike, strong, sub, sup, tt, b, u, i, ol, ul, li, fieldset, form, label, table, caption, tbody, tfoot, thead, tr, th, td, main, canvas, embed, footer, header, nav, section, video {
  margin: 0;
  padding: 0;
  border: 0;
  font-size: 100%;
  font: inherit;
  vertical-align: baseline;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  text-size-adjust: none;
}

body {
  width: 100%;
  margin: 0;
  padding: 0;
  border-top: 6px solid #8D0001;
  color: #EFEDEA;
  background-color: #202B33;
  font-family: magdelin;
  font-size: 20px;
  line-height: 1.3;
}

#site-header {
  grid-area: header;
}

#site-main {
  grid-area: main;
}

#site-footer {
  grid-area: footer;
}

#site-container {
  max-width: 100%;
  padding: 0 20px;
  margin-bottom: 90px;
  display: grid;
  grid: "header" auto "main" 1fr "footer" auto/1fr;
}
@media only screen and (min-width: 1100px) {
  #site-container {
    grid: "header main" auto "footer footer" auto/30% 70%;
  }
}

footer {
  margin-top: 1rem;
  clear: both;
  border-top: 1px solid #EFEDEA;
  display: none;
}

#site-main {
  max-width: 700px;
}
@media only screen and (min-width: 700px) and (max-width: 1100px) {
  #site-main {
    margin: 0 0 0 56px;
  }
}
@media only screen and (min-width: 1100px) {
  #site-main {
    padding: 142px 0 0 50px;
  }
}
#site-main h1 {
  font-size: 38px;
  font-weight: 600;
}
#site-main h1:first-of-type {
  margin-top: 0;
  margin-bottom: 19px;
}
#site-main h2 {
  font-size: 28px;
  font-weight: 600;
  margin-bottom: 8px;
  margin-top: 15px;
}
#site-main p {
  margin: 0 0 12px 0;
}
#site-main a {
  color: #EFEDEA;
  text-decoration: underline;
}
#site-main ul {
  padding-left: 20px;
  list-style-type: square;
}
#site-main ul li {
  padding-bottom: 4px;
}

#site-header {
  display: flex;
  gap: 20px;
  width: 100%;
  padding: 25px 0 35px 0;
}
@media only screen and (min-width: 1100px) {
  #site-header {
    display: block;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: none;
    padding: 65px 0 0 0;
    margin-top: 68px;
  }
}
@media only screen and (min-width: 1100px) {
  #site-header #banner {
    float: right;
    padding-right: 50px;
  }
}
#site-header img {
  display: none;
}
@media only screen and (min-width: 350px) {
  #site-header img {
    display: block;
    float: left;
    max-width: 45px;
  }
}
@media only screen and (min-width: 1100px) {
  #site-header img {
    float: right;
    max-width: 60px;
  }
}
#site-header .name-description {
  float: left;
}
@media only screen and (min-width: 350px) {
  #site-header .name-description {
    padding: 0 0 0 10px;
  }
}
@media only screen and (min-width: 1100px) {
  #site-header .name-description {
    float: right;
    clear: both;
    margin-top: 7px;
  }
}
#site-header .name-description .site-name {
  font-weight: 600;
  font-size: 24px;
  margin: 0;
}
@media only screen and (min-width: 1100px) {
  #site-header .name-description .site-name {
    font-size: 30px;
  }
}
#site-header .name-description .site-description {
  font-weight: 400;
  font-size: 13px;
  margin: 0;
}
@media only screen and (min-width: 1100px) {
  #site-header .name-description .site-description {
    font-size: 18px;
    text-align: right;
  }
}
#site-header .name-description .site-description br {
  display: none;
}
@media only screen and (min-width: 1100px) {
  #site-header .name-description .site-description br {
    display: block;
  }
}

#full-menu {
  display: none;
  flex-grow: 1;
}
@media only screen and (min-width: 700px) {
  #full-menu {
    display: block;
  }
}
@media only screen and (min-width: 1100px) {
  #full-menu {
    float: right;
    clear: both;
    padding-right: 50px;
    margin-top: 20px;
  }
}
#full-menu nav {
  float: right;
}
@media only screen and (min-width: 1100px) {
  #full-menu nav {
    float: none;
  }
}
#full-menu nav ul {
  list-style-type: none;
  padding: 0;
  margin: 13px 0 0 0;
}
#full-menu nav ul li {
  float: left;
  margin-left: 20px;
}
@media only screen and (min-width: 1100px) {
  #full-menu nav ul li {
    float: none;
    text-align: right;
    margin-bottom: 10px;
  }
}
#full-menu nav ul li a {
  color: #EFEDEA;
  text-decoration: none;
}
@media only screen and (min-width: 1100px) {
  #full-menu nav ul li a {
    font-size: 22px;
    opacity: 0.8;
  }
  #full-menu nav ul li a:hover {
    opacity: 1;
  }
}
#full-menu nav ul li .active {
  font-weight: 500;
  text-decoration: underline;
  opacity: 1;
}

#mobile-menu {
  flex-grow: 1;
}
@media only screen and (min-width: 700px) {
  #mobile-menu {
    display: none;
  }
}

input {
  display: none;
}

.open {
  background-color: #EFEDEA;
  width: 24px;
  height: 4px;
  display: block;
  border-radius: 2px;
  cursor: pointer;
  position: relative;
  top: 8px;
}

.open:before {
  content: "";
  background-color: #EFEDEA;
  width: 24px;
  height: 4px;
  display: block;
  border-radius: 2px;
  position: relative;
  top: -8px;
  transform: rotate(0deg);
  transition: all 0.3s ease;
}

.open:after {
  content: "";
  background-color: #EFEDEA;
  width: 24px;
  height: 4px;
  display: block;
  border-radius: 2px;
  position: relative;
  top: 4px;
  transform: rotate(0deg);
  transition: all 0.3s ease;
}

.menuOpen {
  width: 24px;
  height: 20px;
  display: block;
  padding: 13px 0 0 0;
  cursor: pointer;
  float: right;
}

.menuOpen:hover .open:before {
  top: -9px;
}

.menuOpen:hover .open:after {
  top: 5px;
}

.menu {
  position: fixed;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  background: rgba(141, 0, 1, 0.85);
}

.menu label {
  width: 30px;
  height: 30px;
  position: absolute;
  right: 20px;
  top: 20px;
  background-size: 100%;
  cursor: pointer;
}

.menu .menuContent {
  position: relative;
  top: 30%;
  font-size: 40px;
  text-align: center;
  padding-bottom: 20px;
  margin-top: -170px;
}

.menu ul {
  list-style: none;
  padding: 0;
  margin: 0 auto;
  max-width: 75%;
}

.menu ul li a {
  display: block;
  color: white;
  text-decoration: none;
  transition: color 0.2s;
  padding: 10px 0;
}

.menu ul li a:hover {
  color: #8D0001;
}

.menu ul li:hover {
  background: rgba(255, 255, 255, 0.9);
}

.menuEffects {
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.5s, visibility 0.5s;
}

.menuEffects ul {
  transform: translateY(0%);
  transition: all 0.5s;
}

#menuToggle:checked ~ .menuEffects {
  opacity: 1;
  visibility: visible;
  transition: opacity 0.5s;
}

#menuToggle:checked ~ .menuEffects ul {
  opacity: 1;
}

#menuToggle:checked ~ .menuOpen .open {
  background-color: transparent;
}

#menuToggle:checked ~ .menuOpen .open:before {
  content: "";
  background-color: white;
  transform: rotate(45deg);
  position: absolute;
  top: 0;
  right: 0;
  z-index: 1;
}

#menuToggle:checked ~ .menuOpen .open:after {
  content: "";
  background-color: white;
  transform: rotate(-45deg);
  position: relative;
  top: 0;
  right: 0;
  z-index: 1;
}

#menuToggle:not(:checked) ~ .menuEffects ul {
  transform: translateY(-30%);
}

.meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: -70px 0 -65px 0;
}
.meta .item {
  margin: -28px 0 0 0;
}
.meta .item p {
  margin: 0 !important;
}
.meta .item .title {
  text-transform: uppercase;
  font-size: 13px;
  font-weight: 600;
  padding: 0 0 3px 0;
  letter-spacing: 0.3px;
}
.meta .item .info {
  font-size: 18px;
  font-weight: 500;
}
.meta .item .info .emoji {
  padding-right: 6px;
  font-size: 16px;
}
.cap {
  margin: 0;
  padding: 0;
  font-style: italic;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  font-size: 16px;
}

.work-gallery {
  list-style-type: none !important;
  padding: 0 !important;
  margin: 30px 0;
  display: flex;
  flex-wrap: wrap;
  width: 100%;
}
.work-gallery li {
  max-width: 160px;
  margin: 0 20px 20px 0;
  padding: 0 !important;
  border: 8px solid #FFF;
}
.work-gallery li a img {
  width: 100%;
  display: block;
}

#site-header #banner {
  zoom: 1;
}
#site-header #banner:before, #site-header #banner:after {
  content: " ";
  display: block;
  height: 0;
  overflow: hidden;
}
#site-header #banner:after {
  clear: both;
}